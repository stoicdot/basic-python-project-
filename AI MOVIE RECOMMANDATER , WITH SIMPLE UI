import streamlit as st
import os
import time
from google import genai
from dotenv import load_dotenv

# Load environment variables
load_dotenv()

# Page Config for professional look
st.set_page_config(page_title="AI Movie Recommender", page_icon="🎬", layout="wide")

# Virtual Motion: Custom CSS for animations
st.markdown("""
<style>
@keyframes slideInDown {
    0% { transform: translateY(-50px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
}
.animated-title {
    animation: slideInDown 0.8s ease-out;
    text-align: center;
    color: #FF4B4B;
    font-weight: 800;
}
</style>
""", unsafe_allow_html=True)

st.markdown('<h1 class="animated-title">🎬 AI MOVIE RECOMMENDER</h1>', unsafe_allow_html=True)
st.markdown("<p style='text-align: center; color: #888;'>DISCOVER YOUR NEXT FAVORITE WATCH</p>", unsafe_allow_html=True)
st.divider()

# Sidebar for clean UI layout
with st.sidebar:
    st.header("⚙️ Preferences")
    type1 = st.selectbox("INDUSTRY / TYPE", ["HOLLYWOOD", "BOLLYWOOD", "ANIME"])
    type2 = st.radio("AUDIO FORMAT", ["SUB", "DUB"])
    num_movies = st.slider("NUMBER OF RECOMMENDATIONS", min_value=1, max_value=20, value=5)

# Main Content
st.subheader("🎭 SELECT THE GENRE")
cols = st.columns(4)

with cols[0]:
    genre_options = ["ACTION", "COMEDY", "DRAMA", "HORROR", "ROMANCE", "SCIENCE FICTION", "SHONEN", "THRILLER"]
    genre1 = st.radio("GENRE", genre_options)

st.write("") # Spacing
submit = st.button("🚀 GET RECOMMENDATION", use_container_width=True)

if submit:
    st.divider()
    
    # Motion / Feedback State
    with st.spinner(f'🎥 Magic in progress... Fetching top {num_movies} {genre1} picks for you...'):
        time.sleep(1) # Artificial delay for animation effect
        
        # Secure API Key Fetching
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            st.error("⚠️ API Key is missing! Please check your .env file.")
            st.stop()
            
        prompt = f"""
        Act as an expert film critic. Recommend the TOP {num_movies} BEST {type1} movies/shows in the {genre1} genre (available in {type2}).
        
        STRICT INSTRUCTIONS:
        1. Provide exactly {num_movies} titles ranked strictly from #1 (Best) down based on IMDb rating.
        2. The output must be perfectly formatted in Markdown.
        3. Do not include any introductory fluff, conversational text, or conclusion.
        
        Use this exact format for each recommendation:
        ### [RANK]. [MOVIE NAME] ([RELEASE YEAR]) | IMDb: [RATING]/10
        * **Why it's best:** [1 sentence punchy reason]
        * **Logline:** [1 sentence plot overview]
        ---
        """
        
        try:
            client = genai.Client(api_key=api_key)
            response = client.models.generate_content(
                model="gemini-3.6-flash",
                contents=prompt,
            )
            
            # Virtual Motion: Celebration effect on success
            st.balloons()
            
            # Display beautifully formatted results
            with st.container():
                st.markdown(response.text)
                
        except Exception as e:
            st.error(f"🚨 An error occurred while communicating with the AI: {e}")
