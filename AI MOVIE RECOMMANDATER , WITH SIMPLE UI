    # Language Detail
    if type1 == "HOLLYWOOD":
        st.success("LANGUAGE: HOLLYWOOD - AMERICAN CINEMA KNOWN FOR GLOBAL REACH, ADVANCED VFX, AND LARGE-SCALE PRODUCTIONS.")
    elif type1 == "BOLLYWOOD":
        st.success("LANGUAGE: BOLLYWOOD - HINDI CINEMA KNOWN FOR RICH STORYTELLING, EMOTIONS, DRAMA, AND MUSICAL ENTERTAINMENT.")
        
    st.info(f"AUDIO TYPE: {type2}".upper())
    
    if genre1 == "ACTION":
        st.success(f"GENRE: {genre1} - FEATURES HIGH-STAKES RISKS, PHYSICAL STUNTS, AND INTENSE FIGHT SCENES.")
    elif genre1 == "COMEDY":
        st.success(f"GENRE: {genre1} - EMPHASIZES HUMOR, FUNNY DIALOGUES, AND LIGHT-HEARTED ENTERTAINMENT.")
    elif genre1 == "DRAMA":
        st.success(f"GENRE: {genre1} - FOCUSES ON REALISTIC CHARACTERS, DEEP EMOTIONAL CONFLICTS, AND STORYLINE.")
    elif genre1 == "HORROR":
        st.success(f"GENRE: {genre1} - DESIGNED TO SCARE, CREATE TENSION, SUSPENSE, AND DREAD.")
    elif genre1 == "ROMANCE":
        st.success(f"GENRE: {genre1} - EXPLORES LOVE STORIES, RELATIONSHIPS, AND PASSIONATE JOURNEYS.")
    elif genre1 == "SCIENCE FICTION":
        st.success(f"GENRE: {genre1} - FEATURES FUTURISTIC SCIENCE, TIME TRAVEL, SPACE, AND ADVANCED TECHNOLOGY.")

api_key = os.getenv("GEMINI_API_KEY")
prompt = f"""
Act as an expert film critic. Recommend the TOP 10 BEST {type1} movies in the {genre1} genre (available in {type2}).

STRICT INSTRUCTIONS:
1. Provide exactly 10 movies ranked strictly from #1 (Best) down to #10 based on IMDb rating.
