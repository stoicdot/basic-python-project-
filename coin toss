import random 
import time
import sys
print("--- Guess HEADS or TAILS ---")
choice = ["HEADS","TAILS"]
print("Select (HEADS/TAILS)")
while True :
    a = input("Enter : ").strip().upper()
    match a : 
        case "HEADS" | "TAILS" :
            break
        case _ : 
            print("Enter Again")
            continue
   
print("You Choose",a,sep=" - ")
print("FLIPPING....",end="",flush=True)
frames = ["⬤", "◗", "❘", "◖"]  # ya ["🪙", "🟨"]

for _ in range(10):
    for frame in frames:
        sys.stdout.write(f"\rFlipping coin... {frame}")
        sys.stdout.flush()
        time.sleep(0.15)
print("\rFlipping coin... Done!  ")
result = random.choice(choice)
time.sleep(1)
print("\rCoin Lands on ",result)
time.sleep(0.5)
if a == result :
    print("--Win--")
else :
    print("--Lose--")
