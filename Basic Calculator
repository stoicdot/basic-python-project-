#---calculator---#
print("//<---Calculator--->\\\\")
def main():
    while True :
            try :
                num1 = float(input("Enter First Num: "))
                num2 = float(input("Enter Second Num: "))
                break
            except ValueError :
                print(" ---Again Enter a Num--- ")
   
    #opertion you want to perform ...
    print("Select The arithmetic operation :")
    operations = ("Sum", "Diff", "Multi", "Divi")
    print(operations)
    op = input().strip().lower()
    #on the base of select op...
    if op == "sum":
        print(add(num1, num2))
    elif op == "diff":
        print(diff(num1, num2))
    elif op == "multi":
        print(multi(num1, num2))
    elif op == "divi":
        if num2 == 0:
            print("Can't Be Divided By Zero")
        else:
            print(divi(num1, num2))
    else:
        print("Invalid Operation!")

#funtion for addition of two number...
def add(num1, num2):
    return num1 + num2

#funtion for subtraction of two number...
def diff(num1, num2):
    return num1 - num2

#funtion for multiplication of two number...
def multi(num1, num2):
    return num1 * num2

#funtion for division of two number...
def divi(num1, num2):
    return num1 / num2


main()
