from time import sleep
while True :
    try :
        num1 = float(input("Enter 1st Number : "))
        num2 = float(input("Enter 2nd Number : "))
        break
    except ValueError :
        print("---AGAIN ENTER NUMBERS---")
        continue

print("Select operation","\n[ Add , Sub , Multi , Divi ]")
while True :
    op = input("Enter : ").strip().capitalize()
    print("loading...")
    sleep(2)

    match op:
        case "Add" | "Sub" | "Multi" | "Divi":
            break
        case _:
            print("---Again Enter Correct Operation---")
            continue

def main() :
    if op == "Add":
            print(add(num1, num2))
    elif op == "Sub":
            print(diff(num1, num2))
    elif op == "Multi":
            print(multi(num1, num2))
    elif op == "divi":
        if num2 == 0:
            print("Can't Be Divided By Zero")
        else:
            print(divi(num1, num2))
    else:
        print("Invalid Operation!")
#funtion for addition of two number...
def add(num1, num2):
    return num1 + num2

#funtion for subtraction of two number...
def diff(num1, num2):
    return num1 - num2

#funtion for multiplication of two number...
def multi(num1, num2):
    return num1 * num2

#funtion for division of two number...
def divi(num1, num2):
    return num1 / num2
main()
