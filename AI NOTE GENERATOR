import sys
import os
import time
import re
import itertools
import threading
from dotenv import load_dotenv
from google import genai


load_dotenv()
def main ():
    print("\n=== AI SUMMERIZE|NOTES GENEARTOR ===")
    user_input=input("ENTER THE TOPIC YOU WANT TO SUMMERIZE :")
    try:cleaned_input=clean_input(user_input)
    except Exception as e :
        print(f"\nERROR {e}")
        sys.exit(1)
    topic=build_prompt(cleaned_input)
    stop_loading=False
    spinning=threading.Thread(target=loading,args=(lambda:stop_loading,))
    spinning.start()
    try:
        result=gemini(topic)
    except Exception as e:
        stop_loading=True
        spinning.join()
        print(f"API ERROR {e} !!")
        sys.exit(1)
    finally:
        stop_loading=True
        spinning.join()

    print("\n === AI RESULT ===")
    print(result)


def clean_input(x:str)->str:
    qus=x.strip()
    if not qus :
        raise ("PLEASE ENTER A TOPIC")
    x = re.sub(r"\s+", " ", x).strip()
    x = re.sub(r'[^a-zA-Z0-9\s\-\_\.\@]', '', x)
    if len(qus)<3:
        raise ("TOO FEW ARGUMENT")
    if len(qus)>50:
        raise ("TOO MAY ARGUMENT")
    return qus

def build_prompt(y:str)->str:
    return( f"You are an expert AI tutor."
        f"Explain the topic {y} in simple English with examples:")

def loading(stop):
    frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    for frame in itertools.cycle(frames):
        if stop():
            break
        sys.stdout.write(f"\rAI IS THINKING {frame}")
        sys.stdout.flush()
        time.sleep(0.1)
    sys.stdout.write("\r" + " " * 30 + "\r") 
    sys.stdout.flush()

def gemini (z:str)->str:
    url=os.getenv("GEMINI_API_KEY")
    if not url :
        raise ValueError ("NO KEY FOUND...")
    client=genai.Client(api_key=url)
    try:
        response=client.models.generate_content(
            model="gemini-3.6-flash",
            contents=z
        )
        if not response.text:
            raise ValueError ("NOT RESULT FOUND...")
        return response.text
    except :
        ValueError ("GEMINI REQUEST FAILED...")
        sys.exit(1)

if __name__=="__main__":
    main()
